{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .firebender/hooks/format.ps1",
        "timeout": 30
      }
    ],
    "beforeReadFile": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .firebender/hooks/guard-heavy.ps1",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .firebender/hooks/guard-destructive.ps1",
        "timeout": 10,
        "matcher": "push --force|Remove-Item.*-Recurse.*-Force|rm -rf"
      }
    ],
    "stop": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .firebender/hooks/auto-typecheck.ps1",
        "timeout": 120,
        "loop_limit": 1
      }
    ]
  }
}
