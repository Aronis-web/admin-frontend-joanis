# =============================================================================
# ERP-aio · variables de entorno (ejemplo)
# =============================================================================
# Copia este archivo a `.env` y rellena los valores. NUNCA commitees `.env`.
#
# Todo lo prefijado con EXPO_PUBLIC_ se INLINEA en el bundle cliente
# (web/native) y por lo tanto es PÚBLICO. No pongas secretos ahí.
# =============================================================================

# API backend
EXPO_PUBLIC_API_URL=https://api.tu-dominio.com
EXPO_PUBLIC_APP_ID=

# Sentry (el DSN público está pensado para clientes, pero restringe el proyecto
# por dominio en el dashboard de Sentry)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENABLED=false
EXPO_PUBLIC_ENVIRONMENT=development

# Versión (se puede sobreescribir en CI)
EXPO_PUBLIC_APP_VERSION=
EXPO_PUBLIC_BUILD_NUMBER=

# Google Maps: restringe la key por HTTP referrer en Google Cloud Console
# para que solo funcione desde app.gritlabs.app (y localhost en dev).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ------------------ SOLO PARA CI / DESKTOP (nunca EXPO_PUBLIC_) --------------
# Usado por electron-updater para descargar releases privados desde GitHub.
# Se inyecta en tiempo de build/exec del .exe, NO viaja al cliente.
GH_TOKEN=
